# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Optional for live FRED macro evidence. Get a key at https://fred.stlouisfed.org/docs/api/api_key.html.
FRED_API_KEY=

# SEC requires a contactable User-Agent, in the form "Company Name contact@domain.com".
# Gotcha: SEC refuses some consumer webmail domains outright -- a naver.com address is answered
# with HTTP 403, not an auth error, and www.sec.gov labels that refusal "Request Rate Threshold
# Exceeded", so it reads like throttling. A gmail.com address or your own domain works.
# Set BOTH keys: sec.py accepts either, but edgartools reads only EDGAR_IDENTITY, so leaving it
# blank keeps identity resolution working while every SEC filings request fails.
# Neither is a secret.
SERENITY_SEC_USER_AGENT=
EDGAR_IDENTITY=

# Optional OpenFIGI key for authenticated mapping tools. The current v2 public
# mapping adapter does not require it.
OPENFIGI_API_KEY=

# Optional credentials for adaptive public-data evidence. EIA also supports its
# public DEMO_KEY path; the others return a typed not_requested/unavailable result
# when their capability needs a key that is not configured.
EIA_API_KEY=
BEA_API_KEY=
BLS_REGISTRATION_KEY=
SAM_API_KEY=
USPTO_API_KEY=

# X cookies — only needed to (re)scrape the thesis DB; not needed to run analysis.
X_AUTH_TOKEN=
X_CT0=
X_TWID=
