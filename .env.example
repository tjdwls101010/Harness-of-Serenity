# Copy to .env and fill in. .env is gitignored — never commit real keys.

# FRED API (macro: rates, inflation, net liquidity, ERP). Required for live macro evidence.
# Get a free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional — only if a module uses Google models for narrative enrichment.
GOOGLE_API_KEY=
GOOGLE_MODEL=
GOOGLE_THINKING_LEVEL=

# X/Twitter cookies — only needed to (re)scrape the thesis DB; not needed to run analysis.
X_AUTH_TOKEN=
X_CT0=
X_TWID=
