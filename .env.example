# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Optional for live FRED macro evidence. Get a key at https://fred.stlouisfed.org/docs/api/api_key.html.
FRED_API_KEY=

# SEC requires a contactable User-Agent. Set this preferred name, or set the legacy
# EDGAR_IDENTITY alternative below; do not set either to a secret.
SERENITY_SEC_USER_AGENT=
EDGAR_IDENTITY=

# Optional OpenFIGI key for authenticated mapping tools. The current v2 public
# mapping adapter does not require it.
OPENFIGI_API_KEY=

# Optional credentials for adaptive public-data evidence. EIA also supports its
# public DEMO_KEY path; the others return a typed not_requested/unavailable result
# when their capability needs a key that is not configured.
EIA_API_KEY=
BEA_API_KEY=
BLS_REGISTRATION_KEY=
SAM_API_KEY=
USPTO_API_KEY=

# X cookies — only needed to (re)scrape the thesis DB; not needed to run analysis.
X_AUTH_TOKEN=
X_CT0=
X_TWID=
