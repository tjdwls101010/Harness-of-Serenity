{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:method-coding-output:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "packet_id", "packet_sha256", "dispositions"],
  "properties": {
    "schema_id": {"type": "string", "const": "urn:serenity:schema:method-coding-output:1"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/disposition"}}
  },
  "$defs": {
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "label", "rationale"],
      "properties": {
        "axis": {"type": "string", "enum": ["observation_type", "causal_hop", "value_capture", "identity_provenance", "lens", "catalyst_mechanism", "funding_capital_structure", "bear_falsifier", "timing_entry", "recommendation_scope", "confidence_hedge", "contradiction", "outcome_postmortem"]},
        "label": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "coding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "evidence_sought", "inference", "action_horizon", "falsifier", "codes"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "evidence_sought": {"type": "string", "minLength": 1},
        "inference": {"type": "string", "minLength": 1},
        "action_horizon": {"type": "object", "additionalProperties": false, "required": ["action", "horizon"], "properties": {"action": {"type": "string", "minLength": 1}, "horizon": {"type": "string", "minLength": 1}}},
        "falsifier": {"type": "string", "minLength": 1},
        "codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/code"}}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "disposition", "coding", "uncertainty_notes", "contradiction_notes"],
      "properties": {
        "chunk_id": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "enum": ["coded", "no_reusable_move"]},
        "coding": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["trigger", "evidence_sought", "inference", "action_horizon", "falsifier", "codes"],
          "properties": {
            "trigger": {"type": "string", "minLength": 1},
            "evidence_sought": {"type": "string", "minLength": 1},
            "inference": {"type": "string", "minLength": 1},
            "action_horizon": {"type": "object", "additionalProperties": false, "required": ["action", "horizon"], "properties": {"action": {"type": "string", "minLength": 1}, "horizon": {"type": "string", "minLength": 1}}},
            "falsifier": {"type": "string", "minLength": 1},
            "codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/code"}}
          }
        },
        "uncertainty_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "contradiction_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
