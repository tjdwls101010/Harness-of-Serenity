{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:evidence-catalog:1",
  "title": "Serenity evidence provider capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "catalog_id", "created_at", "providers"],
  "properties": {
    "schema_id": {"const": "urn:serenity:schema:evidence-catalog:1"},
    "catalog_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provider"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "tier", "capabilities", "source_kind"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1},
        "tier": {"enum": ["baseline", "adaptive", "optional"]},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_providers": {
          "description": "Source-identity names this owner's adapters may stamp on a provider envelope, beyond the always-accepted provider_id.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_kind": {"type": "string", "minLength": 1}
      }
    }
  }
}
