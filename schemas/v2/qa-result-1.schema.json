{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:qa-result:1",
  "title": "Serenity QA result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "result_id", "case_id", "mode", "executed_at", "counts", "failure_taxonomy", "evidence_refs", "reviewer_outcome", "reviewer", "invariant_results"],
  "properties": {"schema_id": {"type": "string", "const": "urn:serenity:schema:qa-result:1"}, "result_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "mode": {"type": "string", "enum": ["deterministic", "live", "historical"]}, "executed_at": {"$ref": "#/$defs/dateTime"}, "counts": {"type": "object", "additionalProperties": false, "required": ["passed", "failed", "total", "denominator", "wilson_interval"], "properties": {"passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "denominator": {"type": "string", "minLength": 1}, "wilson_interval": {"type": "object", "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}}}}, "failure_taxonomy": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "count"], "properties": {"category": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 0}}}}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "reviewer_outcome": {"type": "string", "enum": ["pass", "fail", "needs_review"]}, "reviewer": {"type": "string", "minLength": 1}, "invariant_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invariantResult"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}, "dateTime": {"type": "string", "format": "date-time"}, "invariantResult": {"type": "object", "additionalProperties": false, "required": ["invariant", "outcome", "evidence_refs", "rationale"], "properties": {"invariant": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "enum": ["pass", "fail", "needs_review"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "rationale": {"type": "string", "minLength": 1}}}}
}
