{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:hypothesis-ledger:1",
  "title": "Serenity competing hypothesis ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "ledger_id", "run_id", "revision", "created_at", "updated_at", "hypotheses", "history", "content_hash"],
  "properties": {
    "schema_id": {"const": "urn:serenity:schema:hypothesis-ledger:1"},
    "ledger_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "hypotheses": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hypothesis"}},
    "history": {"type": "array", "items": {"$ref": "#/$defs/history"}},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "statement", "predictions", "falsifier", "status", "supporting_fact_refs", "contradicting_fact_refs", "requested_evidence_ids"],
      "properties": {
        "hypothesis_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "predictions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "falsifier": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "supported", "weakened", "rejected", "unresolved"]},
        "supporting_fact_refs": {"$ref": "#/$defs/idList"},
        "contradicting_fact_refs": {"$ref": "#/$defs/idList"},
        "requested_evidence_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "content_hash", "updated_at"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
