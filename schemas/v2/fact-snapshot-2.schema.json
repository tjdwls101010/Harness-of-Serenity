{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:fact-snapshot:2",
  "title": "Serenity v2 deterministic fact snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "snapshot_id", "run_id", "as_of", "identity", "fetched_at", "facts", "content_hash"],
  "properties": {
    "schema_id": {"const": "urn:serenity:schema:fact-snapshot:2"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "as_of": {"$ref": "#/$defs/date"},
    "identity": {"$ref": "#/$defs/identity"},
    "fetched_at": {"$ref": "#/$defs/dateTime"},
    "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "date": {"type": "string", "format": "date"},
    "dateTime": {"type": "string", "format": "date-time"},
    "nullableDate": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "nullableDateTime": {"oneOf": [{"$ref": "#/$defs/dateTime"}, {"type": "null"}]},
    "availability": {"enum": ["available", "not_disclosed", "not_applicable", "unavailable", "invalid", "not_requested", "stale", "conflict"]},
    "identity": {"type": "object", "additionalProperties": false, "required": ["ticker", "name", "exchange", "listing_type"], "properties": {"requested_ticker": {"type": "string", "minLength": 1}, "ticker": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}, "normalized_symbol": {"type": "string", "minLength": 1}, "cik": {"type": "string", "pattern": "^[0-9]{10}$"}, "figi": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "exchange": {"type": "string", "minLength": 1}, "listing_type": {"enum": ["common", "adr", "etf"]}, "resolution_source": {"type": "string", "minLength": 1}, "provenance": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["provider", "source_uri", "raw_content_sha256", "request_id", "transform_version"], "properties": {"provider": {"type": "string", "minLength": 1}, "source_uri": {"type": "string", "format": "uri"}, "raw_content_sha256": {"$ref": "#/$defs/sha256"}, "request_id": {"$ref": "#/$defs/id"}, "transform_version": {"type": "string", "minLength": 1}}}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "name", "availability", "value", "unit", "provider", "request_id", "effective_at", "observed_at", "available_at", "fetched_at", "source_version"], "properties": {"fact_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "availability": {"$ref": "#/$defs/availability"}, "value": {}, "unit": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "request_id": {"$ref": "#/$defs/id"}, "effective_at": {"$ref": "#/$defs/nullableDate"}, "period_start": {"$ref": "#/$defs/nullableDate"}, "period_end": {"$ref": "#/$defs/nullableDate"}, "observed_at": {"$ref": "#/$defs/nullableDate"}, "available_at": {"$ref": "#/$defs/nullableDateTime"}, "fetched_at": {"$ref": "#/$defs/dateTime"}, "source_version": {"type": "string", "minLength": 1}, "source_uri": {"type": "string", "format": "uri"}, "raw_content_sha256": {"$ref": "#/$defs/sha256"}, "identity_bindings": {"type": "object", "additionalProperties": {"type": "string"}}}, "allOf": [{"if": {"properties": {"availability": {"const": "available"}}, "required": ["availability"]}, "then": {"required": ["source_uri", "raw_content_sha256", "identity_bindings"], "properties": {"value": {"not": {"type": "null"}}, "effective_at": {"$ref": "#/$defs/date"}, "observed_at": {"$ref": "#/$defs/date"}, "available_at": {"$ref": "#/$defs/dateTime"}, "identity_bindings": {"minProperties": 1}}}, "else": {"properties": {"value": {"type": "null"}}}}]}
  }
}
