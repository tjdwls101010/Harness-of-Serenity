{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:evidence-request:1",
  "title": "Serenity typed adaptive evidence request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "request_id", "run_id", "hypothesis_ids", "capability_id", "question", "evidence_type", "provider_policy", "acceptance_criteria", "requested_at", "provider_parameters", "content_hash"],
  "properties": {
    "schema_id": {"const": "urn:serenity:schema:evidence-request:1"},
    "request_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "hypothesis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "capability_id": {"type": "string", "minLength": 3},
    "question": {"type": "string", "minLength": 1},
    "evidence_type": {"type": "string", "minLength": 1},
    "provider_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers"],
      "properties": {
        "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "historical_cutoff": {"type": "string", "format": "date-time"},
        "allow_network": {"type": "boolean"}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_at": {"type": "string", "format": "date-time"},
    "provider_parameters": {"type": "object"},
    "status": {"enum": ["open", "fulfilled", "unavailable", "cancelled"]},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
