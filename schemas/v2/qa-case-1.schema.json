{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:qa-case:1",
  "title": "Serenity reproducible QA case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "case_id", "family", "prompt", "cutoff", "expected_invariants", "isolation_policy"],
  "properties": {"schema_id": {"const": "urn:serenity:schema:qa-case:1"}, "case_id": {"$ref": "#/$defs/id"}, "family": {"enum": ["discovery", "single-ticker", "physical-ai", "near-miss", "degraded-data", "displacement-fear"]}, "prompt": {"type": "string", "minLength": 1}, "cutoff": {"type": "string", "format": "date-time"}, "expected_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "isolation_policy": {"type": "object", "additionalProperties": false, "required": ["exclude_prior_verdicts", "exclude_corpus_answers", "network_mode"], "properties": {"exclude_prior_verdicts": {"const": true}, "exclude_corpus_answers": {"const": true}, "network_mode": {"enum": ["offline", "recorded", "live"]}}}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}}
}
