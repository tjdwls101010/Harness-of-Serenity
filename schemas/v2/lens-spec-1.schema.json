{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:lens-spec:1",
  "title": "Serenity declared arithmetic lens",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "lens_id", "run_id", "question", "formula", "inputs", "output_unit", "assumptions", "validity_constraints"],
  "properties": {"schema_id": {"const": "urn:serenity:schema:lens-spec:1"}, "lens_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "question": {"type": "string", "minLength": 1}, "formula": {"type": "string", "minLength": 1}, "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "fact_ref", "unit"], "properties": {"name": {"type": "string", "minLength": 1}, "fact_ref": {"$ref": "#/$defs/id"}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "unit": {"type": "string", "minLength": 1}}}}, "output_unit": {"type": "string", "minLength": 1}, "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "scenario_labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "validity_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}}
}
