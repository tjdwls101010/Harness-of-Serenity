{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serenity:schema:prospective-record:1",
  "title": "Serenity append-only prospective outcome record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "record_id", "content_hash", "registered_at", "decision", "benchmark", "checkpoint_schedule", "condition_hit_is_trade", "observations"],
  "properties": {
    "schema_id": {"const": "urn:serenity:schema:prospective-record:1"},
    "record_id": {"$ref": "#/$defs/id"},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "registered_at": {"type": "string", "format": "date-time"},
    "decision": {"$ref": "#/$defs/decisionContract"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "checkpoint_schedule": {"type": "array", "items": {"$ref": "#/$defs/scheduledCheckpoint"}},
    "condition_hit_is_trade": {"const": false},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "availability": {"enum": ["available", "not_disclosed", "not_applicable", "unavailable", "invalid", "not_requested", "stale", "conflict"]},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "status"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "status": {"enum": ["met", "unmet", "monitoring", "not_applicable"]}
      }
    },
    "decisionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "lineage_id", "version", "decision_content_hash", "current_pointer_hash", "action", "as_of", "entry_conditions", "falsifiers"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "lineage_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "decision_content_hash": {"$ref": "#/$defs/sha256"},
        "current_pointer_hash": {"$ref": "#/$defs/sha256"},
        "action": {"enum": ["RECOMMEND_NOW", "ENTER_ON_TRIGGER", "MONITOR", "PASS", "BLOCKED"]},
        "as_of": {"type": "string", "format": "date"},
        "entry_conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker"],
      "properties": {
        "ticker": {"type": "string", "pattern": "^[A-Z0-9.-]+$"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "scheduledCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "due_on"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "due_on": {"type": "string", "format": "date"},
        "note": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "format": "uri"},
        "available_at": {"type": "string", "format": "date-time"},
        "fetched_at": {"type": "string", "format": "date-time"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "value", "provenance"],
      "properties": {
        "availability": {"$ref": "#/$defs/availability"},
        "value": {},
        "provenance": {"$ref": "#/$defs/provenance"},
        "currency": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "state": {"enum": ["not_triggered", "triggered", "unresolved"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "available"}}}, "then": {"properties": {"value": {"not": {"type": "null"}}}}, "else": {"properties": {"value": {"type": "null"}}}}
      ]
    },
    "conditionHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "hit"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "hit": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "as_of", "subject_price", "benchmark_return", "mechanism_evidence", "falsifier_state", "condition_hits", "measurement_hash", "previous_event_hash", "refreshed_at", "condition_hit_is_trade", "event_hash"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/id"},
        "as_of": {"type": "string", "format": "date"},
        "subject_price": {"$ref": "#/$defs/measurement"},
        "benchmark_return": {"$ref": "#/$defs/measurement"},
        "mechanism_evidence": {"$ref": "#/$defs/measurement"},
        "falsifier_state": {"$ref": "#/$defs/measurement"},
        "condition_hits": {"type": "array", "items": {"$ref": "#/$defs/conditionHit"}},
        "measurement_hash": {"$ref": "#/$defs/sha256"},
        "previous_event_hash": {"$ref": "#/$defs/sha256"},
        "refreshed_at": {"type": "string", "format": "date-time"},
        "condition_hit_is_trade": {"const": false},
        "event_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
