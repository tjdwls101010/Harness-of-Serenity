              },
              "named": {
                "enum": [
                  "business",
                  "risk_factors",
                  "mda"
                ],
                "description": "A 10-K defines all three; a 10-Q defines risk_factors and mda only. An unsupported form/section pair returns a typed invalid naming what the form does define, never not_disclosed."
              },
              "item": {
                "type": "string",
                "minLength": 1,
                "description": "Part-qualified on a 10-Q ('Part II, Item 1A'), because a bare 'Item 1' silently resolves to Part I. Bare on a 10-K ('Item 1A')."
