        "alfred-fred.vintage-series": {
          "requires_historical_cutoff": true,
          "parameters": {
            "type": "object",
            "required": [
              "series_id",
              "observation_start"
            ],
            "additionalProperties": false,
            "properties": {
              "series_id": {
                "type": "string",
                "minLength": 1
              },
              "observation_start": {
                "type": "string",
                "format": "date",
                "description": "Required here, unlike macro-series: an unbounded revision history returns a row per observation per vintage and has written over a thousand artifacts in one request."
              },
              "observation_end": {
                "type": "string",
                "format": "date"
              }
            },
            "description": "Every vintage published by the cutoff, including revisions since superseded. Answers how a number was revised, where macro-series answers what it was."
          }
