                    "enum": [
                      "press_release",
                      "presentation",
                      "prepared_remarks",
                      "call_transcript",
                      "other"
                    ]
                  }
                }
              },
              "origin_binding": {
                "type": "object",
                "required": [
                  "issuer_domain",
                  "binding_source_ref"
                ],
                "properties": {
                  "issuer_domain": {
                    "type": "string",
                    "minLength": 1
                  },
                  "binding_source_ref": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The SEC record that ties this domain to the issuer. The run verifies it; an unverified binding is refused."
                  }
                }
              }
            },
            "description": "An issuer that declares no website in its SEC submission puts this capability structurally out of reach. Record that with `evidence unmet` as typed not_disclosed rather than leaving the run with nothing saved."
          }
        }
      }
