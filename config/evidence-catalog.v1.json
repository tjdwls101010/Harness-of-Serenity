                  },
                  "cik": {
                    "type": "string",
                    "pattern": "^[0-9]{10}$",
                    "description": "Zero-padded to ten digits."
                  },
                  "issuer": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": "All three, because a partial SEC identity is refused rather than repaired from memory. Resolve it with `snapshot security` before requesting a filing."
              }
            },
            "description": "The filer's submissions index. Its availability is the acceptance instant of the newest filing it lists, so a historical cutoff refuses it: today's index names filings a reader at that cutoff could not have seen."
          }
        },
