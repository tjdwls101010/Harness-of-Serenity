{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/.venv/bin/python",
            "args": [".claude/hooks/session_health.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/.venv/bin/python",
            "args": [".claude/hooks/lifecycle_gate.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
