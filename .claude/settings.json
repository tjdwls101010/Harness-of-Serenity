{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_status.py\"",
            "timeout": 35
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/evidence_discipline.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/web_number_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/data_integrity_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "serenity-filings",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_discipline.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/verdict_gate.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
